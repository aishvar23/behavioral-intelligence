# Copy this file to local.properties and fill in your values.
# local.properties is gitignored — never commit it.

# Android SDK path
# Windows:
sdk.dir=C\:\\Users\\<YOUR_USER>\\AppData\\Local\\Android\\Sdk
# macOS / Linux:
# sdk.dir=/Users/<YOUR_USER>/Library/Android/sdk

# Facebook credentials — get from Facebook Developer Console
# App: Behavioral Intelligence · App ID: 1655685855631376
FACEBOOK_APP_ID=1655685855631376
FACEBOOK_CLIENT_TOKEN=<from Facebook Developer Console → Settings → Advanced → Client token>

# Google Sign-In has NO entries here.
# It is configured via mobile/android/app/google-services.json (gitignored).
# Download it from Firebase Console → Project Settings → Android app → google-services.json.
# The web client ID in mobile/src/config.ts is already committed — no local change needed.
